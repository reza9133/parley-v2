# Parley frontend configuration (copy to .env). Everything here is public: never put a private key in this file.
# Address of the deployed Parley contract on Studionet. Leave empty to run the site in demo mode with sample data.
VITE_PARLEY_ADDRESS=0x5d084E85056Acc332793f34667b8a9890f7B2Bd9
# Optional: override the Studionet RPC (defaults to the one built into genlayer-js).
VITE_RPC_URL=
# Optional: block explorer base URL used for links.
VITE_EXPLORER_URL=https://explorer-studio.genlayer.com
